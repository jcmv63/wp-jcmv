{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jcmv/boutique",
	"title": "Boutique du club",
	"category": "jcmv",
	"icon": "products",
	"description": "Les produits publiés ayant une photo, triés par ordre d'affichage. Une famille peut être sélectionnée pour n'afficher qu'une partie du catalogue.",
	"textdomain": "wp-jcmv",
	"attributes": {
		"famille": {
			"type": "string",
			"default": ""
		},
		"limite": {
			"type": "number",
			"default": 0
		},
		"colonnes": {
			"type": "number",
			"default": 3
		},
		"afficherDetails": {
			"type": "boolean",
			"default": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php",
	"supports": {
		"html": false,
		"multiple": true,
		"spacing": {
			"margin": [ "top", "bottom" ]
		}
	}
}
